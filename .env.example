# Copy to .env and fill in. Every variable is described in server/config.js.

# Hostname Caddy gets a certificate for (deploy/docker-compose.yml); the widget URL is https://$WIDGET_HOST/
WIDGET_HOST=pokemon.example.org

# Optional: only these Matrix homeservers may sign in (comma-separated server names).
# ALLOWED_HOMESERVERS=matrix.org,example.org

# Optional: only members of this room may use the server. Needs a bot account joined to the room.
# The same bot sends sign-in codes by DM to people whose Matrix app has no widgets (Element X, FluffyChat...).
# REQUIRE_ROOM=!roomid:example.org
# MATRIX_BOT_TOKEN=
# MATRIX_BOT_HOMESERVER=https://matrix.example.org

# Optional: allow the unofficial Gen 1/2 -> Gen 3 conversion (players still have to tick a box each time).
# UNOFFICIAL_TRANSFERS=1

# Optional: build the image with self-hosted sprites (1, default) or load them from GitHub (0).
# FETCH_SPRITES=1

# Optional limits (defaults shown)
# HOME_BOXES=40
# API_REQUESTS_PER_MINUTE=600
# WS_MESSAGES_PER_SECOND=10
